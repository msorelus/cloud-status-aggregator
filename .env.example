# Port the API listens on
PORT=8080

# Set MOCK=true to run with bundled sample data (no Azure auth, no network).
MOCK=false

# Microsoft.ResourceHealth/emergingIssues API version
EMERGING_ISSUES_API_VERSION=2022-10-01

# Public Azure Status RSS feed (no auth). Override for other locales if needed.
STATUS_FEED_URL=https://azure.status.microsoft/en-us/status/feed/

# OPTIONAL: comma-separated subscription IDs to also pull subscription-scoped
# Service Health events (via Resource Graph). Leave empty to stay fully
# subscription-independent.
SUBSCRIPTION_IDS=

# Sovereign cloud overrides (defaults shown are Azure public cloud)
# ARM_BASE_URL=https://management.azure.com
# ARM_SCOPE=https://management.azure.com/.default

# Per-source network timeout (ms)
FETCH_TIMEOUT_MS=15000

# --- Change watcher (GET /api/status/changes + webhook push) ---
# Microsoft publishes no push mechanism for the public Azure Status feed — the
# RSS feed is poll-only. The watcher polls, diffs against the last-seen
# snapshot, and POSTs only the deltas. Leave WATCH_ENABLED unset for a pure
# read-only API.
WATCH_ENABLED=false

# Poll cadence. Clamped to a 15000 floor regardless of what is set here.
WATCH_INTERVAL_MS=60000

# Subscriber endpoint for change notifications. Leave empty to still record
# changes at /api/status/changes without pushing them anywhere.
WEBHOOK_URL=

# HMAC-SHA256 signing key. Sent as `x-aggregator-signature: sha256=<hex>` over
# the exact raw body. Generate with: openssl rand -hex 32
# In Azure this comes from Key Vault via the Bicep template — do not commit it.
WEBHOOK_SECRET=

# --- Local-only auth (do NOT use in production; prefer Managed Identity) ---
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- MCP endpoint authentication (Microsoft Entra ID) ---
# Off by default so mock mode and the test suite run without a tenant.
# When true, POST/GET/DELETE /mcp require a valid Entra bearer token and the
# app serves /.well-known/oauth-protected-resource so MCP clients can discover
# the authorization server. GET /healthz always reports which mode is live.
# Only /mcp is protected — the REST API and dashboard stay open.
MCP_AUTH_ENABLED=false

# Tenant that issues the tokens. Defaults to the deployment tenant in Bicep.
MCP_AUTH_TENANT_ID=

# Expected `aud` claim: the API app registration's BARE application ID.
# NOT the api://<guid> URI — v2.0 tokens use the raw GUID even though the
# client requests the scope as api://<guid>/status.read. Getting this wrong
# 401s every request after a sign-in that looked completely successful.
# Both forms are accepted defensively, so either value works, but the GUID is
# what you will actually observe in a decoded token.
MCP_AUTH_AUDIENCE=

# Scopes advertised in the protected-resource metadata. Bare names are
# qualified with this service's own MCP endpoint URL, e.g.
# https://<host>/mcp/status.read. That requires the endpoint URL to be
# registered as an Application ID URI on the API app registration; without it
# Entra rejects the token request with AADSTS9010010, because clients that
# implement RFC 8707 send the endpoint URL as the `resource` parameter and
# Entra derives the resource from the scope.
# Set fully qualified values here to override — e.g. api://<guid>/status.read
# for clients that do not send a resource indicator. A client that requests a
# BARE scope gets a Microsoft Graph token, which then fails validation.
MCP_AUTH_SCOPES=status.read

# Shown as `resource_name` in the metadata document (editor sign-in prompt).
MCP_AUTH_RESOURCE_NAME=Cloud Status Aggregator

# Sovereign cloud override for the Entra authority.
# MCP_AUTH_AUTHORITY_HOST=https://login.microsoftonline.com

# External URL clients reach this app on. Used to build the `resource`
# identifier in the metadata, which must match what the client connected to.
# Bicep derives this from the Container Apps FQDN — set it only for a custom
# domain or when running behind Front Door / API Management.
PUBLIC_BASE_URL=
